APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000

# AI settings — all processing is local, no paid API keys required
MODEL_SIZE=recommended
DEVICE=auto
COMPUTE_TYPE=float16
ENABLE_DIARIZATION=false

# Only needed if ENABLE_DIARIZATION=true (free Hugging Face account, local inference)
HF_TOKEN=

OFFLINE_MODE=false

# --- Deployment / public-access settings ---
# APP_PASSWORD: if set, every API request must include a matching
# X-App-Password header (or ?app_password= for direct links). Leave unset
# for local development. Strongly recommended if you deploy this publicly,
# since the app has no user account system by design.
APP_PASSWORD=

# FRONTEND_ORIGIN: comma-separated list of allowed origins for CORS. Set this
# to your deployed frontend's real URL (e.g. https://your-app.vercel.app).
FRONTEND_ORIGIN=http://localhost:3000

# NEXT_PUBLIC_API_URL: set on the FRONTEND deployment, pointing at your
# deployed backend's URL (e.g. https://your-api.onrender.com).
NEXT_PUBLIC_API_URL=http://localhost:8000
